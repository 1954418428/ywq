{
  "name": "yw-showcase",
  "version": "1.0.0",
  "private": true,
  "description": "移动端人物展示（Taro4 + React18 + JavaScript），支持 H5 与原生 APP（React Native/Expo），纯前端实现，预留后端接口入口",
  "scripts": {
    "dev:h5": "taro build --type h5 --watch",
    "build:h5": "taro build --type h5",
    "dev:rn": "taro build --type rn --watch",
    "build:rn": "taro build --type rn",
    "type-check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@bam.tech/react-native-image-resizer": "^3.0.10",
    "@react-native-async-storage/async-storage": "1.21.0",
    "@react-native-camera-roll/camera-roll": "^7.8.3",
    "@react-native-clipboard/clipboard": "^1.14.3",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-community/netinfo": "11.1.0",
    "@tarojs/components": "4.3.0",
    "@tarojs/components-rn": "4.3.0",
    "@tarojs/helper": "4.3.0",
    "@tarojs/plugin-framework-react": "4.3.0",
    "@tarojs/plugin-platform-h5": "4.3.0",
    "@tarojs/react": "4.3.0",
    "@tarojs/router-rn": "4.3.0",
    "@tarojs/runtime": "4.3.0",
    "@tarojs/runtime-rn": "4.3.0",
    "@tarojs/shared": "4.3.0",
    "@tarojs/taro": "4.3.0",
    "@tarojs/taro-rn": "4.3.0",
    "core-js": "^3.36.0",
    "expo": "~50.0.0",
    "expo-av": "~13.10.6",
    "expo-barcode-scanner": "~12.9.3",
    "expo-brightness": "~11.8.0",
    "expo-camera": "~14.1.3",
    "expo-file-system": "~16.0.9",
    "expo-image-picker": "~14.7.1",
    "expo-keep-awake": "~12.8.2",
    "expo-location": "~16.5.5",
    "expo-sensors": "~12.9.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "^0.73.6",
    "react-native-device-info": "^14.0.0",
    "react-native-image-zoom-viewer": "^3.0.1",
    "react-native-root-siblings": "^5.0.1",
    "react-native-safe-area-context": "4.8.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@tarojs/cli": "4.3.0",
    "@tarojs/rn-runner": "4.3.0",
    "@tarojs/vite-runner": "4.3.0",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "babel-preset-taro": "4.3.0",
    "postcss": "^8.4.38",
    "sass": "~1.77.0",
    "typescript": "^7.0.2",
    "vite": "^4.5.3"
  }
}
