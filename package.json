{
  "name": "yw-showcase",
  "version": "1.0.0",
  "private": true,
  "description": "移动端人物展示（Taro4 + React18 + JavaScript），支持 H5，纯前端实现，预留后端接口入口",
  "scripts": {
    "dev:h5": "taro build --type h5 --watch",
    "build:h5": "taro build --type h5",
    "type-check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@tarojs/components": "4.3.0",
    "@tarojs/helper": "4.3.0",
    "@tarojs/plugin-framework-react": "4.3.0",
    "@tarojs/plugin-platform-h5": "4.3.0",
    "@tarojs/react": "4.3.0",
    "@tarojs/runtime": "4.3.0",
    "@tarojs/shared": "4.3.0",
    "@tarojs/taro": "4.3.0",
    "core-js": "^3.36.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/preset-react": "^7.29.7",
    "@tarojs/cli": "4.3.0",
    "@tarojs/vite-runner": "4.3.0",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "babel-preset-taro": "4.3.0",
    "postcss": "^8.4.38",
    "react-refresh": "^0.19.0",
    "sass": "~1.77.0",
    "typescript": "^7.0.2",
    "vite": "^4.5.3"
  }
}
